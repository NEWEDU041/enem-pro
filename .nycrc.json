{
  "all": true,
  "reporter": [
    "html",
    "text",
    "json",
    "lcov"
  ],
  "report-dir": "./coverage",
  "temp-dir": "./.nyc_output",
  "skip-full": false,
  "produce-source-map": false,
  "instrument": true,
  "include": [
    "lib/**/*.js",
    "lib/**/*.ts",
    "src/**/*.js",
    "src/**/*.ts",
    "app/**/*.js",
    "app/**/*.ts",
    "index.js",
    "index.ts"
  ],
  "exclude": [
    "**/*.d.ts",
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.git/**",
    "**/__tests__/**",
    "**/tests/**",
    "**/*.test.js",
    "**/*.test.ts",
    "**/*.spec.js",
    "**/*.spec.ts"
  ],
  "branches": 60,
  "lines": 60,
  "functions": 60,
  "statements": 60
}