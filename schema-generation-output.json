    "faqPage": {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "name": "ENEM Basics & Registration",
      "url": "https://questoesenem.pro/faq-1",
      "dateModified": "2026-11-02",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is ENEM and who can take it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ENEM (Exame Nacional do Ensino Médio) is the national high school exam in Brazil. It is open to any Brazilian or foreigner who wants to assess their knowledge and gain admission to universities."
          }
        },
        {
          "@type": "Question",
          "name": "When is ENEM held?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ENEM is typically held once per year, usually in November. Applications usually open in May-June."
          }
        },
        {
          "@type": "Question",
          "name": "How many times can I take ENEM?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can take ENEM as many times as you want. Each year, a new exam is offered, and previous scores can be used for university applications."
          }
        },
        {
          "@type": "Question",
          "name": "What is the application fee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As of 2024, there is a registration fee (taxa de inscrição). Check the official INEP website for current amounts and exemption eligibility."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use my ENEM score for university admission?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, ENEM scores are used by most Brazilian universities through SISU (Sistema de Seleção Unificada) and other mechanisms."
          }
        }
      ],
