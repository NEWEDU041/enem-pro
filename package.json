    "@opentelemetry/instrumentation-http": "^0.26.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/instrumentation-redis": "^0.72.0",
    "@opentelemetry/resources": "^1.0.0",
    "@opentelemetry/sdk-node": "^0.26.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^7.120.0",
    "@sentry/tracing": "^7.120.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "axios": "^1.20.0",
    "bull": "^4.16.5",
    "framer-motion": "^12.42.2",
    "google-auth-library": "^10.9.1",
    "googleapis": "^174.0.0",
    "gsap": "^3.15.0",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.29.0",
    "next": "^14.2.0",
    "next-pwa": "^5.6.0",
    "pg": "^8.22.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "redis": "^6.3.0",
    "resend": "^6.12.4",
    "speakeasy": "^2.0.0",
    "stripe": "^22.2.0",
    "swagger-ui-react": "^5.34.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^8.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "gray-matter": "^4.0.3",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.5",
    "typescript": "^5",
