{
  "regions": ["iad1", "gru1", "sfo1"],
  "crons": [
    {
      "path": "/api/cron/refresh-stats",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/email-drip",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/gsc-weekly-report",
      "schedule": "0 9 * * 1"
    }
  ],
  "functions": {
    "api/**": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "buildCommand": "npm run prebuild && next build",
  "env": {
    "ENABLE_EDGE_CACHING": "true",
    "MULTI_REGION_ENABLED": "true",
    "PRIMARY_REGION": "gru1",
    "FALLBACK_REGION": "iad1",
    "EDGE_REGION": "sfo1"
  }
}
